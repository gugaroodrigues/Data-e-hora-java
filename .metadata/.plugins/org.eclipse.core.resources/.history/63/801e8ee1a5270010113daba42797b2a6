package app;

import java.time.Instant;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.ZoneId;

public class DataHoraGlobal {

	
	//Convertendo data-hora global para local
	
	public static void main(String[] args) {
		
		LocalDate d01 = LocalDate.parse("2025-05-02");
		LocalDateTime d02 = LocalDateTime.parse("2025-05-02T01:30:26");
		Instant d03 = Instant.parse("2025-05-02T01:30:26Z");
		
		LocalDate r1 = LocalDate.ofInstant(d03, ZoneId.systemDefault());
		LocalDate r2 = LocalDate.ofInstant(d03, ZoneId.of("Portugal"));
		
		LocalDateTime r3 = LocalDateTime.ofInstant(d03, ZoneId.systemDefault());
		LocalDateTime r4 = LocalDateTime.ofInstant(d03, ZoneId.of("Portugal"));
		
		
		
		System.out.println("Resultado 1 =" + r1);
		System.out.println("Resultado 2 =" + r2);
		System.out.println("Resultado 3 =" + r3);
		System.out.println("Resultado 4 =" + r4);
		
		System.out.println("d01 =" + d01.getDayOfMonth());
		System.out.println("d01 =" + d01.getMonthValue());
		System.out.println("d01 =" + d01.getYear());
		
		System.out.println("d02 =" + d02.getHour());
		System.out.println("d02 =" + d02.getMinute());






	}

}
